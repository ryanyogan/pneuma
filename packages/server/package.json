{
  "name": "@pneuma/server",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "postinstall": "bun run --cwd ../database db:generate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.11",
    "@ai-sdk/openai": "^4.0.11",
    "@hono/zod-validator": "^0.8.0",
    "@pneuma/database": "workspace:*",
    "@pneuma/shared": "workspace:*",
    "ai": "^7.0.20",
    "dotenv": "^17.4.2",
    "hono": "^4.12.28",
    "zod": "^4.4.3"
  }
}
